# === OpenAI API Key for GPT-based responses ===
OPENAI_API_KEY=API-KEY

# === MySQL Database Configuration for User Identification ===
DB_HOST=HOST               # Host where the MySQL server is running
DB_USER=admin                     # MySQL username
DB_PASSWORD=Password           # MySQL password
DB_NAME=chatbot_user_identification  # Database storing user profiles and serial numbers

# === Microsoft Graph OAuth Credentials for To Do and Outlook Integration ===
CLIENT_ID=Client-ID  # Azure app's client ID
CLIENT_SECRET=Secret Key # Azure app's client secret
REDIRECT_URI=http://localhost:8000                # Redirect URI to capture auth code locally
SCOPES=Tasks.ReadWrite Mail.ReadWrite             # Microsoft Graph permissions for To Do and Mail access
